{
  "name": "geomap-app",
  "version": "4.0.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "predev": "npm run prepare:vendor",
    "dev": "vite",
    "prebuild:pages": "npm run prepare:vendor",
    "build:pages": "vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:standalone:all": "node scripts/build-standalone.mjs --variant=full && node scripts/build-standalone.mjs --variant=lite",
    "build:release": "npm run build:standalone:all && node scripts/copy-release-to-dist.mjs",
    "capture:readme": "node scripts/capture-readme.mjs",
    "capture:history": "node scripts/capture-history.mjs",
    "capture:selection": "node scripts/capture-selection.mjs",
    "capture:data": "node scripts/capture-data.mjs",
    "format": "prettier --write src tests scripts server updatedocs/V4_PRIVATE_DEPLOYMENT.md *.json *.md",
    "format:check": "prettier --check src tests scripts server updatedocs/V4_PRIVATE_DEPLOYMENT.md *.json *.md",
    "lint": "eslint src tests scripts server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "private:server": "node --env-file-if-exists=.env server/private-server.mjs",
    "pretest:e2e": "npm run build:standalone:all",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:server && python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "dompurify": "3.4.13",
    "html2canvas": "1.4.1",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "leaflet.markercluster": "1.5.3",
    "papaparse": "5.4.1",
    "tabulator-tables": "5.5.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
